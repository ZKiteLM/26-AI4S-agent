DEPLOYMENT_MODE=local
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://research:change-me@localhost:5432/research
REDIS_URL=redis://localhost:6379/0
# Set to 1 for a single-process smoke test without Redis.
CELERY_TASK_ALWAYS_EAGER=0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=research
S3_SECRET_KEY=change-me
S3_BUCKET=research
QDRANT_URL=http://localhost:6333
APP_SECRET=change-this-before-exposing-service
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=change-me
# Each model endpoint may be localhost (development) or a cloud API (deployment).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# openai: OpenAI-compatible remote API; ollama: local native API with thinking disabled.
LLM_PROVIDER=openai
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
GITHUB_TOKEN=
MINERU_COMMAND=mineru-kit
# local: MinerU Python SDK in parser Worker; remote: compatible MinerU V1 API.
PARSER_BACKEND=local
PARSER_VECTOR_ENHANCE=1
MINERU_API_URL=
MINERU_API_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_API_BASE_URL=http://localhost:8000
# For the cloud profile, set both to https://your-domain before building web.
SITE_DOMAIN=localhost
# Optional registry overrides for mirrors or preloaded images.
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
QDRANT_IMAGE=ghcr.io/qdrant/qdrant/qdrant:v1.20.0
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
NODE_IMAGE=node:24-alpine
