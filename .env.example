# Copy to .env in the project root. Do not commit real passwords or API keys.
# local: host services and optional Ollama; cloud: external HTTPS LLM/embedding/MinerU.
DEPLOYMENT_MODE=local

# Database, queue, object storage and search (matching infra/compose.yml).
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://research:change-me@localhost:5432/research
REDIS_URL=redis://localhost:6379/0
# Test-only: execute Celery tasks in process; keep 0 for normal operation.
CELERY_TASK_ALWAYS_EAGER=0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=research
S3_SECRET_KEY=change-me
S3_BUCKET=research
LOCAL_STORAGE=storage
QDRANT_URL=http://localhost:6333
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=

# Authentication. Replace all sample secrets before sharing a deployment.
APP_SECRET=change-this-before-exposing-service
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=change-me

# Model endpoints. Choose one LLM provider and fill its URL, model and key.
# openai: OpenAI-compatible Chat Completions; ohmygpt: Responses; ollama: local native API.
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
OHMYGPT_API_KEY=
LLM_MODEL=
OLLAMA_NUM_CTX=16384
AGENT_MAX_ROUNDS=8
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# External scholarly APIs. Keys may be empty except where provider limits require one.
GITHUB_TOKEN=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CITATION_REFERENCES_TTL_HOURS=168
CITATION_CITATIONS_TTL_HOURS=24
METRICS_REFRESH_HOURS=24
CODE_RETRY_DAYS=7
EXTERNAL_ERROR_RETRY_HOURS=1

# Parser. Local MinerU requires the optional parser dependencies and model files.
MINERU_COMMAND=mineru-kit
PARSER_BACKEND=local
PARSER_VECTOR_ENHANCE=1
PARSER_VECTOR_MAX_PAGES=50
MINERU_API_URL=
MINERU_API_KEY=

# Public URLs. In Docker builds PUBLIC_API_BASE_URL is injected into the web app.
PUBLIC_API_BASE_URL=http://localhost:8000
SITE_DOMAIN=localhost

# Optional container image overrides.
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
QDRANT_IMAGE=ghcr.io/qdrant/qdrant/qdrant:v1.20.0
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.17.10
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
NODE_IMAGE=node:24-alpine
# Optional read-only diagnostic API key for /api/v1/debug/overview in cloud mode.
DEBUG_CONSOLE_KEY=
